@model AdminTasksList
@{ ViewData["Title"] = "Manage tasks"; }

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3">
    <h1>Manage tasks</h1>
    <a asp-action="CreateTask" class="btn btn-primary">New task</a>
</div>
<form asp-action="Tasks" method="get" class="row g-3 align-items-end admin-filter mb-4">
    <div class="col-12 col-sm">
        <label for="task-search" class="form-label">Title</label>
        <input id="task-search" name="search" value="@Model.Search" class="form-control" />
    </div>
    <div class="col-auto form-check ms-3 mb-2">
        <input id="unassigned" class="form-check-input" type="checkbox" name="unassigned" value="true" checked="@Model.Unassigned" />
        <label for="unassigned" class="form-check-label">Unassigned only</label>
    </div>
    <div class="col-auto d-flex gap-2"><button class="btn btn-primary" type="submit">Search</button><a class="btn btn-outline-secondary" asp-action="Tasks">Clear filters</a></div>
</form>

@if (Model.Results.Tasks.Count == 0)
{
    <p class="alert alert-light border">No tasks to display.</p>
}
else
{
    <div class="table-responsive admin-table">
        <table class="table align-middle mb-0">
            <thead><tr><th scope="col">Title</th><th scope="col">Owner</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody>
            @foreach (var task in Model.Results.Tasks)
            {
                <tr>
                    <td class="text-break">@task.Title</td>
                    <td>@(task.OwnerName ?? "Unassigned")</td>
                    <td><span class="badge @(task.IsCompleted ? "text-bg-success" : "text-bg-secondary")">
                        @(task.IsCompleted ? "Completed" : "Open")
                    </span></td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="EditTask" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-action="DeleteTask" asp-route-id="@task.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<nav class="d-flex flex-wrap gap-2" aria-label="Task pages">
    @if (Model.Page > 1)
    {
        <a asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-unassigned="@Model.Unassigned"
           class="btn btn-outline-secondary">Previous</a>
    }
    @if (Model.Page < (Model.Results.Total + 24L) / 25)
    {
        <a asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-unassigned="@Model.Unassigned"
           class="btn btn-outline-secondary">Next</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Dashboard</a>
</nav>

@model AdminTaskForm
@{
    var creating = Model.Id == 0;
    ViewData["Title"] = creating ? "New task" : "Edit task";
}

<h1 class="mb-3">@ViewData["Title"]</h1>
<form asp-action="@(creating ? "CreateTask" : "EditTask")" asp-route-id="@(creating ? null : Model.Id.ToString())" method="post" class="card card-body">
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3" data-owner-picker>
        <div class="mb-2" data-owner-search hidden>
            <label for="owner-search" class="form-label">Search owners</label>
            <input id="owner-search" class="form-control" type="search" autocomplete="off"
                   placeholder="Filter by username" aria-controls="OwnerId" />
            <div class="form-text" data-owner-matches role="status"></div>
        </div>
        <label asp-for="OwnerId" class="form-label"></label>
        <select asp-for="OwnerId" class="form-select" aria-describedby="owner-help owner-error">
            <option value="">Unassigned</option>
            @foreach (var owner in Model.Owners)
            {
                <option value="@owner.Id">@owner.UserName</option>
            }
        </select>
        <div id="owner-help" class="form-text">Select Unassigned to keep this task visible only to administrators.</div>
        <span asp-validation-for="OwnerId" id="owner-error" class="text-danger" role="alert"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsCompleted" class="form-check-input" />
        <label asp-for="IsCompleted" class="form-check-label"></label>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" type="submit">Save changes</button>
        <a asp-action="Tasks" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/admin-owner-picker.js" asp-append-version="true"></script>
}
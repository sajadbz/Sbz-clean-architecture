@model AdminDashboard
@{ ViewData["Title"] = "Overview"; }

<div class="admin-heading">
    <h1>Overview</h1>
    <p>Monitor task progress and manage account access.</p>
</div>
<dl class="metric-grid">
    <div class="metric-card"><dt>Accounts</dt><dd>@Model.Users</dd><dd class="metric-link"><a asp-action="Accounts">Manage users</a></dd></div>
    <div class="metric-card"><dt>Open tasks</dt><dd>@Model.Tasks.Open</dd><dd class="metric-link"><a asp-action="Tasks">Manage tasks</a></dd></div>
    <div class="metric-card"><dt>Completed tasks</dt><dd>@Model.Tasks.Completed</dd><dd class="metric-link"><a asp-action="Reports">View reports</a></dd></div>
    <div class="metric-card"><dt>Unassigned tasks</dt><dd>@Model.Tasks.Unassigned</dd><dd class="metric-link"><a asp-action="Tasks" asp-route-unassigned="true">Review unassigned</a></dd></div>
</dl>
<section class="admin-panel" aria-labelledby="task-progress">
    <div class="admin-panel-header">
        <div><h2 id="task-progress">Task completion</h2><p>@Model.Tasks.Completed of @Model.Tasks.Total tasks completed</p></div>
        <a asp-action="Reports" class="btn btn-outline-primary btn-sm">Open reports</a>
    </div>
    @if (Model.Tasks.Total > 0)
    {
        <meter class="completion-meter" value="@Model.Tasks.Completed" min="0" max="@Model.Tasks.Total"
               aria-label="Completed tasks">@Model.Tasks.Completed of @Model.Tasks.Total</meter>
    }
    else
    {
        <p class="mb-0 text-secondary">Completion will appear once a task is created.</p>
    }
</section>

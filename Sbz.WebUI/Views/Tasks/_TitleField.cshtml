@model TaskForm

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" required maxlength="@Sbz.Domain.Tasks.TaskItem.MaxTitleLength"
           aria-describedby="task-title-error" />
    <span asp-validation-for="Title" id="task-title-error" class="text-danger" role="alert"></span>
</div>

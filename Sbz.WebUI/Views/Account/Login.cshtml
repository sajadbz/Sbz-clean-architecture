@model LoginForm
@{ ViewData["Title"] = "Sign in"; }

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
        <h1 class="mb-3">Sign in</h1>
        <form asp-action="Login" method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden" />
            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" required />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" type="submit">Sign in</button>
                <a asp-action="Register" class="btn btn-outline-secondary">Create account</a>
            </div>
        </form>
    </div>
</div>

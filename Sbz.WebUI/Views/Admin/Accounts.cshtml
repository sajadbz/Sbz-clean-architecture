@model AdminAccountsList
@{ ViewData["Title"] = "Manage users"; }

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-start mb-3">
    <h1>Manage users</h1>
    <a asp-action="CreateAccount" class="btn btn-primary">Create account</a>
</div>
<form asp-action="Accounts" method="get" class="row g-3 align-items-end admin-filter mb-4">
    <div class="col-12 col-sm">
        <label for="user-search" class="form-label">Username</label>
        <input id="user-search" name="search" value="@Model.Search" class="form-control" />
    </div>
    <div class="col-auto d-flex gap-2"><button class="btn btn-primary" type="submit">Search</button><a class="btn btn-outline-secondary" asp-action="Accounts">Clear filters</a></div>
</form>

@if (Model.Results.Accounts.Count == 0)
{
    <p class="alert alert-light border">No users to display.</p>
}
else
{
    <div class="table-responsive admin-table">
        <table class="table align-middle mb-0">
            <thead><tr><th scope="col">Username</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
            <tbody>
            @foreach (var account in Model.Results.Accounts)
            {
                <tr>
                    <td>@account.UserName</td>
                    <td>@(account.IsAdministrator ? "Administrator" : "User")</td>
                    <td><span class="badge @(account.IsLocked ? "text-bg-warning" : "text-bg-success")">
                        @(account.IsDisabled ? "Disabled" : account.IsLocked ? "Locked" : "Active")
                    </span></td>
                    <td><a asp-action="Account" asp-route-id="@account.Id" class="btn btn-sm btn-outline-primary">Manage</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<nav class="d-flex flex-wrap gap-2" aria-label="User pages">
    @if (Model.Page > 1)
    {
        <a asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" class="btn btn-outline-secondary">Previous</a>
    }
    @if (Model.Page < (Model.Results.Total + 24L) / 25)
    {
        <a asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" class="btn btn-outline-secondary">Next</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Dashboard</a>
</nav>
